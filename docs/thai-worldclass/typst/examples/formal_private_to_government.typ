  font: ("Sarabun", "TH Sarabun New", "Noto Sans Thai"),
  justify: true,
)

#private-letter-head(
  number: [........................................................],
  date: [........................................................],
  subject: [ขอแนะนำบริษัท อารยา นิกะห์ วิสาหกิจเพื่อสังคม จำกัด และเปิดช่องทางประสานงานด้านพหุวัฒนธรรมและครอบครัว],
  attention: [ปลัดกระทรวงวัฒนธรรม],
  attachments: (
    [ข้อมูลแนะนำองค์กร (Company Profile) จำนวน #thnum(1) ชุด],
    [สำเนาหนังสือรับรองการเป็นวิสาหกิจเพื่อสังคม จำนวน #thnum(1) ชุด],
  ),
)

ด้วยบริษัท อารยา นิกะห์ วิสาหกิจเพื่อสังคม จำกัด (ARAYA NIKAH SOCIAL ENTERPRISE CO., LTD.) เป็นบริษัทเอกชนจดทะเบียนในประเทศไทย และได้รับการรับรองเป็นวิสาหกิจเพื่อสังคมประเภทแบ่งปันผลกำไรจากสำนักงานส่งเสริมวิสาหกิจเพื่อสังคม (สวส.) บริษัทดำเนินงานด้านการเตรียมความพร้อมก่อนสมรส การนิกะห์ การให้ความรู้ด้านครอบครัวมุสลิม และการประสานงานกรณีคู่สมรสข้ามชาติ โดยทำงานในบริบทที่เชื่อมโยงศาสนา สัญชาติ วัฒนธรรม กฎหมาย และเอกสารของหลายประเทศ

จากการทำงานภาคสนาม ARAYA พบว่า ปัญหาในครอบครัวข้ามวัฒนธรรมไม่ได้เกิดจากความแตกต่างเพียงอย่างเดียว หลายกรณีเกิดจากการที่แต่ละฝ่ายมีข้อมูลไม่เท่ากัน หรือเข้าใจบทบาทและความคาดหวังของกันและกันไม่ตรงกัน ความคลาดเคลื่อนดังกล่าวอาจกระทบต่อคู่สมรส ครอบครัว ตลอดจนผู้หญิงและเด็ก บริษัทจึงให้ความสำคัญกับการเข้าถึงข้อมูลก่อนตัดสินใจ ความรับผิดชอบของคู่สมรส และการสร้างความเข้าใจระหว่างครอบครัวที่มีพื้นฐานต่างกัน

นอกเหนือจากงานด้านการแต่งงานและครอบครัว ARAYA ยังพัฒนาองค์ความรู้ด้านการอยู่ร่วมกันในสังคมพหุวัฒนธรรม การเรียนรู้ศาสนาอิสลามสำหรับผู้สนใจและมุสลิมใหม่ รวมถึงการส่งเสริมผู้ประกอบการทุกศาสนาให้เข้าใจการให้บริการที่เป็นมิตรต่อชาวมุสลิม งานส่วนนี้มุ่งเชื่อมโยงวิถีชีวิตมุสลิมเข้ากับบริบทของสังคมไทย โดยไม่ลดทอนอัตลักษณ์ของแต่ละฝ่าย และยึดหลักการให้เกียรติซึ่งกันและกัน

จึงเรียนมาเพื่อโปรดทราบ และหวังเป็นอย่างยิ่งว่าจะมีโอกาสประสานงานในประเด็นที่เป็นประโยชน์ต่อสังคมไทยต่อไป

